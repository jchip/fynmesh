{
  "name": "create-fynapp",
  "version": "1.1.3",
  "description": "CLI tool to create new FynApp micro frontends",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "create-fynapp": "dist/create-cli.js",
    "cfa": "dist/cfa.js"
  },
  "homepage": "https://github.com/jchip/fynmesh/tree/main/dev-tools/create-fynapp",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "docs": "typedoc --out docs src",
    "prepublishOnly": "fyn run build && fyn run test",
    "install-cfa": "fyn run build && fyn global add ."
  },
  "author": "Joel Chen",
  "files": [
    "federation.d.ts",
    "LICENSE",
    "dist",
    "lib",
    "src",
    "templates/react",
    "agent",
    "skills"
  ],
  "keywords": [
    "fynapp",
    "microfrontend",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynmesh.git",
    "directory": "dev-tools/create-fynapp"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.1",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.8.9",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.0.3",
    "rollup-plugin-no-emit": "^1.3.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.7",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fynjs/cli-args": "^1.0.1",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-virtual": "^3.0.2",
    "aveazul": "^2.0.0",
    "esbuild": "^0.25.12",
    "inquirer": "^9.2.10",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.0.0",
    "rollup-plugin-no-emit": "^1.3.0",
    "rollup-wrap-plugin": "^1.0.0"
  },
  "prettier": {
    "printWidth": 100
  }
}
