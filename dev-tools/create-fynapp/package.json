{
  "name": "create-fynapp",
  "version": "1.1.7",
  "description": "CLI tool to create new FynApp micro frontends",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "create-fynapp": "dist/create-cli.js",
    "cfa": "dist/cfa.js"
  },
  "homepage": "https://www.fynmesh.fyi",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "docs": "typedoc --out docs src",
    "prepublishOnly": "fyn run build && fyn run test",
    "install-cfa": "fyn run build && fyn global add ."
  },
  "author": "Joel Chen",
  "files": [
    "federation.d.ts",
    "LICENSE",
    "dist",
    "lib",
    "src",
    "templates/_generic",
    "templates/react",
    "templates/react18",
    "templates/preact",
    "templates/vue",
    "templates/solid",
    "templates/svelte",
    "templates/marko",
    "templates/vanilla",
    "agent",
    "skills"
  ],
  "keywords": [
    "fynapp",
    "microfrontend",
    "cli",
    "micro-frontend",
    "micro-frontends",
    "module-federation",
    "federation",
    "rollup",
    "systemjs",
    "shared-dependencies",
    "independent-deployment",
    "scaffold",
    "generator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynmesh.git",
    "directory": "dev-tools/create-fynapp"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.5",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "^3.9.10",
    "rollup-plugin-no-emit": "^1.3.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fynjs/cli-args": "^1.2.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-virtual": "^3.0.2",
    "aveazul": "^2.1.10",
    "esbuild": "^0.28.2",
    "inquirer": "^14.2.3",
    "rollup": "^4.64.5",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.1.2",
    "rollup-plugin-no-emit": "^1.3.0",
    "rollup-wrap-plugin": "^1.0.3"
  },
  "resolutions": {
    "**/ts-node/**/diff": "4.0.4",
    "brace-expansion": "5.0.12",
    "lodash-es": "4.18.1"
  },
  "prettier": {
    "printWidth": 100
  }
}
