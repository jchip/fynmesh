{
  "name": "create-fynapp",
  "version": "1.1.3",
  "description": "CLI tool to create new FynApp micro frontends",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "create-fynapp": "dist/create-cli.js",
    "cfa": "dist/cfa.js"
  },
  "homepage": "https://github.com/jchip/fynmesh/tree/main/dev-tools/create-fynapp",
  "license": "Apache-2.0",
  "scripts": {
    "jest-test": "jest test/spec/",
    "build": "rm -rf dist && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "test": "xrun xarc/test-only",
    "prepublishOnly": "xrun --serial [[build, docs], xarc/check]",
    "docs": "xrun xarc/docs",
    "coverage": "xrun xarc/test-cov",
    "install-cfa": "fyn run build && fyn global add ."
  },
  "author": "Joel Chen",
  "files": [
    "LICENSE",
    "dist",
    "lib",
    "src",
    "templates/react",
    "agent",
    "skills"
  ],
  "keywords": [
    "fynapp",
    "microfrontend",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynmesh.git",
    "directory": "dev-tools/create-fynapp"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.9",
    "@xarc/module-dev": "^5.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "rollup-plugin-no-emit": "^1.3.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.7",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@rollup/plugin-virtual": "^3.0.2",
    "aveazul": "^2.0.0",
    "inquirer": "^9.2.10",
    "@fynjs/cli-args": "^1.0.0",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-federation": "^1.0.0",
    "rollup-plugin-no-emit": "^1.3.0",
    "rollup-wrap-plugin": "^1.0.0",
    "tslib": "^2.6.2"
  },
  "prettier": {
    "printWidth": 100
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!rollup-wrap-plugin)"
    ],
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "testEnvironment": "node"
  },
  "@xarc/module-dev": {
    "features": [
      "jest",
      "jestTS",
      "eslint",
      "prettier",
      "typedoc",
      "typescript"
    ]
  }
}
