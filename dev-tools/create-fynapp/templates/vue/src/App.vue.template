<template>
  <div class="fynapp-container">
    <h2 class="fynapp-title">{{ appName }} - Vue {{ vueVersion }}</h2>

    <div class="fynapp-content">
      <p>Welcome to your new FynApp!</p>

      <div class="counter-section">
        <p>
          Count: <strong>{{ count }}</strong>
        </p>
        <button class="fynapp-button" @click="count++">Increment</button>
      </div>

      <div v-if="runtime" class="runtime-info">
        <p>
          <small>
            Running as: {{ runtime.fynApp.name }} v{{ runtime.fynApp.version }}
          </small>
        </p>
      </div>
    </div>
  </div>
</template>

<script>
import { version } from "vue";

export default {
  name: "App",
  props: {
    appName: { type: String, required: true },
    // The FynUnitRuntime handed down from main.ts. Optional so the component
    // can also be mounted on its own, outside the kernel.
    runtime: { type: Object, default: undefined },
  },
  data() {
    return { count: 0, vueVersion: version };
  },
};
</script>

