import vue from "rollup-plugin-vue";
import postcss from "rollup-plugin-postcss";
import replace from "@rollup/plugin-replace";
import { newRollupPlugin } from "rollup-wrap-plugin";
import { createFynAppRollupConfig, env, isProduction } from "create-fynapp";

// High-level factory form — the preferred FynApp rollup config.
// See create-fynapp/agent/CONTRACT.md §3 for the full contract, and
// createFynAppRollupConfig options (framework, exposes, extraPlugins, …).
export default createFynAppRollupConfig({
  name: "{{appName}}",
  framework: "vue",
  typescript: true,
  // Unlike React, the non-React federation path exposes nothing by default —
  // "./main" has to be listed here (CONTRACT.md §3).
  exposes: {
    "./main": "./src/main.ts",
  },
  shared: {
    vue: { singleton: true, semver: "^3.3.4" },
  },
  // resolve .vue without the extension, e.g. `import App from "./App"`.
  resolve: { extensions: [".mjs", ".js", ".json", ".node", ".ts", ".vue"] },
  extraPlugins: [
    // SFC compiler. css:false hands <style> blocks to postcss below rather
    // than letting the plugin emit its own <style> injection.
    newRollupPlugin(vue)({ css: false, template: { isProduction } }),
    newRollupPlugin(postcss)({ inject: true, extract: false }),
    // Vue's runtime reads these compile-time flags; without them the bundle
    // logs a feature-flag warning on boot.
    newRollupPlugin(replace)({
      preventAssignment: true,
      "process.env.NODE_ENV": JSON.stringify(env),
      __VUE_OPTIONS_API__: true,
      __VUE_PROD_DEVTOOLS__: !isProduction,
      __VUE_PROD_HYDRATION_MISMATCH_DETAILS__: false,
    }),
  ],
});
