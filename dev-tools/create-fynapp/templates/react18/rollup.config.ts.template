import commonjs from "@rollup/plugin-commonjs";
import replace from "@rollup/plugin-replace";
import postcss from "rollup-plugin-postcss";
import { newRollupPlugin } from "rollup-wrap-plugin";
import { createFynAppRollupConfig, env } from "create-fynapp";

// High-level factory form — the preferred FynApp rollup config.
// See create-fynapp/agent/CONTRACT.md §3 for the full contract, and
// createFynAppRollupConfig options (framework, exposes, extraPlugins, …).
export default createFynAppRollupConfig({
  name: "{{appName}}",
  framework: "react18",
  typescript: true,
  // "react18" is a React framework, so "./main" is exposed automatically. Add more exposes here, e.g. a middleware:
  //   exposes: { "./middleware/foo": "./src/middleware/foo.ts" },
  exposes: {},
  // Bundle React into this app so it renders on any page. The factory's React
  // default instead marks react external and consume-only
  // (`import: false`), which only works where something else on the page
  // provides React — as the FynMesh demo does with its esm-react adapters.
  // These two options together make the app its own provider.
  external: [],
  shared: {
    react: { singleton: true, semver: "^18.0.0" },
    "react-dom": { singleton: true, semver: "^18.0.0" },
    "react-dom/client": { singleton: true, semver: "^18.0.0" },
  },
  extraPlugins: [
    // React's CommonJS build branches on process.env.NODE_ENV, which does not
    // exist in a browser — it has to be substituted at build time.
    newRollupPlugin(replace)({
      preventAssignment: true,
      "process.env.NODE_ENV": JSON.stringify(env),
    }),
    // React's entry points are CommonJS, so bundling them needs this.
    newRollupPlugin(commonjs)({ transformMixedEsModules: true }),
    // postcss handles `import "./styles.css"` in components.
    newRollupPlugin(postcss)({ inject: true, extract: false }),
  ],
});
