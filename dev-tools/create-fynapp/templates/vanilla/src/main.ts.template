import { useMiddleware } from "@fynmesh/kernel";
import type { FynUnit, FynUnitRuntime } from "@fynmesh/kernel";
import "./styles.css";

/**
 * FynUnit implementation for {{appName}}
 *
 * This handles the FynApp lifecycle:
 * - initialize: Called first to determine readiness
 * - execute: Called when middleware is ready, mounts the app
 * - shutdown: Called when the FynApp is being unloaded
 */
class {{appNamePascal}}Unit implements FynUnit {
  private cleanupFns: Array<() => void> = [];
  private target?: HTMLElement;

  /**
   * Initialize - tell the kernel what mode we're in
   */
  initialize(runtime: FynUnitRuntime) {
    console.debug(`📋 ${runtime.fynApp.name} initialize called`);
    return {
      status: "ready" as const,
      mode: "standalone" as const,
    };
  }

  /**
   * Execute - mount the Plain DOM app
   *
   * Plain DOM renders itself, so this returns "self-managed" in both modes.
   * The "component-factory" result is React-only — it hands the shell a factory
   * taking React (CONTRACT.md §5). What changes under a shell is only where we
   * mount: the shell's renderTarget instead of our own node.
   */
  async execute(runtime: FynUnitRuntime) {
    console.debug(`🚀 ${runtime.fynApp.name} executing`);

    const shellMiddleware = runtime.middlewareContext.get("shell-layout");
    const target = shellMiddleware?.isShellManaged
      ? (shellMiddleware.renderTarget as HTMLElement)
      : this.getOrCreateTarget();

    console.debug(
      `🚀 ${runtime.fynApp.name} mounting in ${
        shellMiddleware?.isShellManaged ? "shell-managed" : "standalone"
      } mode`,
    );

    // A re-execute (app switch under a shell) can hand back a node we already
    // populated, so drop the previous mount before claiming it again.
    this.unmount();
    target.innerHTML = "";

    this.render(target, runtime);

    this.target = target;

    return {
      type: "self-managed",
      target,
      cleanup: () => this.shutdown(),
      metadata: {
        framework: "vanilla",
        capabilities: ["self-managed"],
      },
    };
  }

  /**
   * Shutdown - cleanup when FynApp is unloaded
   */
  shutdown(): void {
    console.debug(`🛑 {{appName}} shutting down`);
    this.unmount();
    this.target = undefined;
  }

  private unmount(): void {
    for (const cleanup of this.cleanupFns.splice(0)) {
      cleanup();
    }
  }

  /** Build the DOM. No framework — this is the whole render. */
  private render(target: HTMLElement, runtime: FynUnitRuntime): void {
    let count = 0;

    const container = document.createElement("div");
    container.className = "fynapp-container";
    container.innerHTML = `
      <h2 class="fynapp-title">${runtime.fynApp.name} - no framework</h2>
      <div class="fynapp-content">
        <p>Welcome to your new FynApp!</p>
        <div class="counter-section">
          <p>Count: <strong class="count">0</strong></p>
          <button class="fynapp-button" type="button">Increment</button>
        </div>
        <div class="runtime-info">
          <p><small>Running as: ${runtime.fynApp.name} v${runtime.fynApp.version}</small></p>
        </div>
      </div>
    `;
    target.appendChild(container);

    const countEl = container.querySelector<HTMLElement>(".count")!;
    const button = container.querySelector<HTMLButtonElement>(".fynapp-button")!;
    const onClick = () => {
      count += 1;
      countEl.textContent = String(count);
    };
    button.addEventListener("click", onClick);
    this.cleanupFns.push(() => button.removeEventListener("click", onClick));
  }

  /** Standalone mode: render into our own node, creating it if needed. */
  private getOrCreateTarget(): HTMLElement {
    let element = document.getElementById("{{appName}}");
    if (!element) {
      element = document.createElement("div");
      element.id = "{{appName}}";
      document.body.appendChild(element);
    }
    return element;
  }
}

// Export the main entry point wrapped with middleware support
export const main = useMiddleware(
  [
    // Add middleware here, e.g.:
    // {
    //   middleware: import('fynapp-design-tokens/middleware/design-tokens/design-tokens',
    //     { with: { type: "fynapp-middleware" } }),
    //   config: { theme: "fynmesh-default" },
    // },
  ],
  new {{appNamePascal}}Unit()
);
