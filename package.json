{
  "name": "fynmesh",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "homepage": "",
  "license": "UNLICENSED",
  "scripts": {
    "bootstrap": "test -e node_modules || fyn; fyn install-federation && fynpo",
    "build": "xrun -s release-gate _fynpo",
    "build-prod": "NODE_ENV=production xrun -s build combine-demo _shell-templates",
    "_shell-templates": "cd demo/demo-server && fyn run build:templates",
    "clean:demo": "rm -rf demo/*/dist",
    "publish-demo": "NODE_ENV=production xrun -s clean:demo build-prod _gh-publish",
    "_gh-publish": "cd demo/demo-server && fyn run gh-publish",
    "start": "cd demo/demo-server && fyn start",
    "install-federation": "fyn clone-fed && cd rollup-federation && fyn && fyn bootstrap",
    "clone-fed": "test -e rollup-federation || git clone https://github.com/jchip/rollup-federation.git",
    "_fynpo": "fynpo"
  },
  "author": "",
  "files": [
    "src",
    "lib",
    "dist"
  ],
  "keywords": [],
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@fynjs/run": "^1.0.0",
    "@types/node": "^24.10.1",
    "fyn": "^3.0.0",
    "fynpo": "^3.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6"
  },
  "fyn": {
    "enforceRegistryDeps": false
  }
}
