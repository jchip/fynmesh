{
  "changeLogMarkers": [
    "## Packages",
    "## Commits"
  ],
  "packages": {
    "autoSearch": true,
    "include": [
      "dev-tools/create-fynapp/examples/*"
    ],
    "publishInclude": [
      "path:core/*",
      "path:demo/*",
      "path:dev-tools/*",
      "path:dev-tools/create-fynapp/examples/*",
      "path:misc/*",
      "path:demo-rollup-externals/*",
      "path:rollup-federation/*"
    ]
  },
  "versionLocks": [
    [
      "@fynmesh/kernel",
      "create-fynapp"
    ]
  ],
  "command": {
    "publish": {
      "tags": {},
      "versionTagging": {},
      "includePackages": [
        "path:core/*",
        "path:dev-tools/*"
      ]
    }
  },
  "fyn": {
    "options": {
      "allowScripts": {
        "esbuild": {
          "semver": "^0.25.0 || ^0.27.0 || ^0.28.0"
        }
      }
    }
  }
}
