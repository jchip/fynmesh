{
  "changeLogMarkers": [
    "## Packages",
    "## Commits"
  ],
  "packages": [
    "core/*",
    "demo/*",
    "dev-tools/*",
    "misc/*",
    "demo-rollup-externals/*",
    "rollup-federation/*"
  ],
  "versionLocks": [
    [
      "@fynmesh/kernel",
      "create-fynapp"
    ]
  ],
  "command": {
    "publish": {
      "tags": {},
      "versionTagging": {},
      "includePackages": [
        "path:core/*",
        "path:dev-tools/*"
      ]
    }
  },
  "fyn": {
    "options": {
      "allowScripts": {
        "esbuild": {
          "semver": "^0.25.0"
        }
      }
    }
  }
}
