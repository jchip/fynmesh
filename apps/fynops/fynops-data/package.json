{
  "private": true,
  "name": "fynops-data",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "FynOps data provider: shares fynops-data-core and ships the SQLite wasm worker it talks to",
  "type": "module",
  "main": "dist/fynapp-entry.js",
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "rollup -c -w",
    "check": "tsc --noEmit",
    "prime-db": "node scripts/prime-db.mts"
  },
  "dependencies": {
    "fynops-data-core": "^1.0.0"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@types/node": "^24.0.10",
    "create-fynapp": "^1.1.7",
    "esbuild": "^0.25.12",
    "rollup": "^4.63.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.0.0",
    "rollup-wrap-plugin": "^1.0.3",
    "typescript": "^5.2.2"
  }
}
