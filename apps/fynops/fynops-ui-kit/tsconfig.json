{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "esm-react": ["./node_modules/@types/react"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "esm-react-dom": ["./node_modules/@types/react-dom/client.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
