{
  "private": true,
  "name": "fynops-data-core",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "FynOps data client: the async API features use to reach the SQLite worker. Bundled by fynops-data as a federation shared module.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
