{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom/client": [
        "./node_modules/@types/react-dom/client.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "esm-react": [
        "./node_modules/@types/react"
      ],
      "esm-react-dom": [
        "./node_modules/@types/react-dom/client.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [
    "node_modules/create-fynapp/federation.d.ts"
  ]
}
