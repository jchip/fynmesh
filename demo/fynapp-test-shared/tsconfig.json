{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "paths": {
      "fynapp-shell-mw/middleware/*": [
        "./node_modules/fynapp-shell-mw/src/middleware/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom/client": [
        "./node_modules/@types/react-dom/client.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [
    "node_modules/create-fynapp/federation.d.ts"
  ]
}
