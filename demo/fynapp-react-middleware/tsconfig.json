{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "lib": [
      "ES2018",
      "DOM"
    ],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom/client": [
        "./node_modules/@types/react-dom/client.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "esm-react": [
        "./node_modules/@types/react"
      ],
      "esm-react-dom": [
        "./node_modules/@types/react-dom/client.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [
    "node_modules/create-fynapp/federation.d.ts"
  ]
}
