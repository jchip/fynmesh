{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "esm-react": [
        "./node_modules/@types/react"
      ],
      "react-dom/client": [
        "./node_modules/@types/react-dom/client.d.ts"
      ],
      "esm-react-dom": [
        "./node_modules/@types/react-dom/client.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [
    "node_modules/create-fynapp/federation.d.ts"
  ]
}
