{
  "private": true,
  "name": "fynapp-analytics-charts",
  "version": "1.0.0",
  "resolutions": {
    "**/rollup-plugin-esbuild/**/picomatch": "4.0.7",
    "lodash-es": "4.18.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Perf Lab analytics suite: chart grid and SVG chart engine",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist dist-raw && rollup -c && cp -R dist dist-raw && federation-combine dist --group startup=grid,renderer",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "analytics-core": "^1.0.0",
    "create-fynapp": "^1.1.7",
    "esbuild": "^0.28.2",
    "esm-react": "^19.1.0",
    "esm-react-dom": "^19.1.0",
    "rollup": "^4.64.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.0.0",
    "rollup-plugin-no-emit": "^1.3.0",
    "rollup-wrap-plugin": "^1.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fynapp-analytics-lib": "^1.0.0",
    "fynapp-react-lib": "^19.0.0"
