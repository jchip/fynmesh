{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist/types",
    "rootDir": "..",
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "@fynmesh/kernel": [
        "./node_modules/@fynmesh/kernel"
      ],
      "esm-react": [
        "./node_modules/@types/react"
      ]
    },
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "../shared-demo-utils/x1-components/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [
    "node_modules/create-fynapp/federation.d.ts"
  ]
}
