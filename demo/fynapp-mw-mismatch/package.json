{
  "private": true,
  "name": "fynapp-mw-mismatch",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Demo FynApp that misdeclares its middleware on purpose, so the amber resolution branches have something to report",
  "type": "module",
  "main": "dist/fynapp-entry.js",
  "exports": {
    ".": "./dist/fynapp-entry.js"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "rollup -c -w",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.3",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/node": "^24.0.10",
    "create-fynapp": "^1.1.5",
    "esbuild": "^0.25.12",
    "rollup": "^4.9.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.0.0",
    "rollup-plugin-no-emit": "^1.3.0",
    "rollup-wrap-plugin": "^1.0.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "fynapp-design-tokens": "^1.0.0"
  }
}
