{
  "private": true,
  "name": "fynapp-shell-mw",
  "version": "1.0.0",
  "resolutions": {
    "**/@rollup/plugin-commonjs/**/picomatch": "4.0.7",
    "**/rollup-plugin-esbuild/**/picomatch": "4.0.7",
    "lodash-es": "4.18.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "FynMesh Shell Middleware Provider - Dynamic FynApp loading and layout management",
