    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "esbuild": "^0.25.12",
    "rollup": "^4.63.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.0.0",
    "typescript": "^5.3.3"
