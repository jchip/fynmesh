{
  "private": true,
  "name": "fynapp-bundled",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Demo FynApp whose dist is combined, so a page can carry a real combined bundle",
  "type": "module",
  "main": "dist/fynapp-entry.js",
  "exports": {
    ".": "./dist/fynapp-entry.js"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c && federation-combine dist --min-group 2",
    "dev": "rollup -c -w",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fynmesh/kernel": "^1.1.2",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/node": "^24.0.10",
    "create-fynapp": "^1.1.4",
    "esbuild": "^0.25.12",
    "rollup": "^4.9.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-federation": "^1.0.0",
    "rollup-plugin-no-emit": "^1.3.0",
    "rollup-wrap-plugin": "^1.0.1",
    "typescript": "^5.2.2"
  }
}
