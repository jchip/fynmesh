{
  "name": "@fynmesh/kernel",
  "version": "1.1.1",
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "description": "FynMesh Kernel",
  "homepage": "https://github.com/jchip/fynmesh/tree/main/core/kernel",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "xrun -s clean gen-version compile-lib build-dist",
    "clean": "rm -rf dist lib",
    "gen-version": "node build/gen-version.mjs",
    "compile-lib": "tsc --build tsconfig.lib.json",
    "build-dist": "rollup -c",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "prepublishOnly": "xrun build"
  },
  "author": "Joel Chen",
  "files": [
    "LICENSE",
    "lib",
    "dist"
  ],
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/fynmesh.git",
    "directory": "core/kernel"
  },
  "devDependencies": {
    "@fynjs/run": "^1.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "rollup": "^4.44.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "federation-js": "^1.0.0"
  },
  "prettier": {
    "printWidth": 100
  }
}
